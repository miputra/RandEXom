{
  "build": {
    "content": [
      {
        "files": [
          "api/*.md",
          "articles/**.md",
          "articles/**.yml",
          "toc.yml",
          "*.md"
        ],
        "exclude": [
          "obj/**",
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "articles/benchmark-results/**/*.json",
          "articles/benchmark-results/**/*.csv"
        ]
      }
    ],
    "dest": "../docs/guide",
    "template": [
      "default",
      "templates/randexom"
    ]
  }
}
